{
  "manifest_version": 3,
  "name": "ΚΗΜΔΗΣ Υπερ-Εργαλείο",
  "version": "8.0.0",
  "description": "Πλήρης αλυσίδα δημοσίων συμβάσεων από ΑΔΑΜ, ΑΔΑ ή Α/Α ΕΣΗΔΗΣ — με οικονομική ανάλυση και εξαγωγή σε Excel, CSV, JSON και ZIP.",
  "author": "developer V. Diakolios",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ΚΗΜΔΗΣ Υπερ-Εργαλείο",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://cerpp.eprocurement.gov.gr/*",
    "https://diavgeia.gov.gr/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "Άνοιγμα του ΚΗΜΔΗΣ Υπερ-Εργαλείου"
    }
  }
}
